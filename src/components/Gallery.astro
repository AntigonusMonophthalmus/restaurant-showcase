---
import { Image } from 'astro:assets';
import { galleryAlt, galleryFeaturedIndices } from '../data/gallery.js';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const images = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!;
    return {
      filename,
      src: mod.default,
      alt: galleryAlt[filename] ?? '',
      featured: false,
    };
  });

galleryFeaturedIndices.forEach((i) => {
  if (images[i]) images[i].featured = true;
});
---

<section class="py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {images.map((img, i) => (
        <button
          type="button"
          data-lightbox
          data-src={img.src.src}
          data-alt={img.alt}
          class:list={[
            'group relative overflow-hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-ochre focus-visible:ring-offset-2',
            img.featured && 'col-span-2 row-span-2',
          ]}
        >
          <Image
            src={img.src}
            alt={img.alt}
            widths={[400, 800, 1200]}
            sizes={img.featured
              ? '(min-width: 1024px) 50vw, 100vw'
              : '(min-width: 1024px) 25vw, 50vw'}
            loading={i < 4 ? 'eager' : 'lazy'}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </button>
      ))}
    </div>
  </div>
</section>

<dialog
  data-lightbox-dialog
  class="m-auto max-h-[92vh] max-w-[92vw] rounded-lg bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
>
  <img data-lightbox-image src="" alt="" class="max-h-[92vh] max-w-[92vw] rounded-lg object-contain" />
</dialog>

<script>
document.addEventListener('astro:page-load', () => {
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  if (!dialog || !image) return;

  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
    btn.addEventListener('click', () => {
      image.src = btn.dataset.src!;
      image.alt = btn.dataset.alt ?? '';
      dialog.showModal();
    });
  });

  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
});
</script>