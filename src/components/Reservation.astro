---
import { site } from '../site.config.js';

// Half-hour slots from opening to 30 min before close, using the longest day.
const timeSlots: string[] = [];
for (let h = 11; h <= 20; h++) {
  timeSlots.push(`${String(h).padStart(2, '0')}:00`);
  timeSlots.push(`${String(h).padStart(2, '0')}:30`);
}

const partySizes = ['1', '2', '3', '4', '5', '6', '7', '8'];

const today = new Date().toISOString().split('T')[0];
---

<section class="py-16">
  <div class="mx-auto max-w-3xl px-4">
    <form
      name="reservation"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      novalidate
      class="space-y-6 rounded-lg border border-ink/10 bg-cream p-6 sm:p-8"
      data-reservation-form
    >
      <input type="hidden" name="form-name" value="reservation" />
      <p hidden>
        <label>Nevyplňujte: <input name="bot-field" /></label>
      </p>

      <div class="grid gap-6 sm:grid-cols-3">
        <div>
          <label for="res-date" class="block text-sm font-medium text-ink">
            Datum <span class="text-muted/70">*</span>
          </label>
          <input
            type="date"
            id="res-date"
            name="date"
            min={today}
            required
            class="mt-2 block w-full rounded-md border border-ink/15 px-3 py-2 text-ink focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
          />
          <p data-error-for="res-date" class="mt-1 hidden text-sm text-red-600" aria-live="polite"></p>
        </div>

        <div>
          <label for="res-time" class="block text-sm font-medium text-ink">
            Čas <span class="text-muted/70">*</span>
          </label>
          <select
            id="res-time"
            name="time"
            required
            class="mt-2 block w-full rounded-md border border-ink/15 bg-cream px-3 py-2 text-ink focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
          >
            <option value="">—</option>
            {timeSlots.map((t) => <option value={t}>{t}</option>)}
          </select>
          <p data-error-for="res-time" class="mt-1 hidden text-sm text-red-600" aria-live="polite"></p>
        </div>

        <div>
          <label for="res-party" class="block text-sm font-medium text-ink">
            Osob <span class="text-muted/70">*</span>
          </label>
          <select
            id="res-party"
            name="party"
            required
            class="mt-2 block w-full rounded-md border border-ink/15 bg-cream px-3 py-2 text-ink focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
          >
            <option value="">—</option>
            {partySizes.map((n) => <option value={n}>{n}</option>)}
            <option value="9+">9 a více</option>
          </select>
          <p data-error-for="res-party" class="mt-1 hidden text-sm text-red-600" aria-live="polite"></p>
        </div>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="res-name" class="block text-sm font-medium text-ink">
            Jméno a příjmení <span class="text-muted/70">*</span>
          </label>
<input
  type="text"
  id="res-name"
  name="name"
  autocomplete="name"
  required
  maxlength="100"
            class="mt-2 block w-full rounded-md border border-ink/15 px-3 py-2 text-ink focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
          />
          <p data-error-for="res-name" class="mt-1 hidden text-sm text-red-600" aria-live="polite"></p>
        </div>

        <div>
          <label for="res-email" class="block text-sm font-medium text-ink">
            E-mail <span class="text-muted/70">*</span>
          </label>
<input
  type="email"
  id="res-email"
  name="email"
  autocomplete="email"
  required
  maxlength="254"
            class="mt-2 block w-full rounded-md border border-ink/15 px-3 py-2 text-ink focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
          />
          <p data-error-for="res-email" class="mt-1 hidden text-sm text-red-600" aria-live="polite"></p>
        </div>
      </div>

      <div>
        <label for="res-phone" class="block text-sm font-medium text-ink">
          Telefon <span class="text-muted/70">(nepovinné)</span>
        </label>
 <input
  type="tel"
  id="res-phone"
  name="phone"
  autocomplete="tel"
  inputmode="tel"
  maxlength="30"
          class="mt-2 block w-full rounded-md border border-ink/15 px-3 py-2 text-ink focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
        />
      </div>

      <div>
        <label for="res-note" class="block text-sm font-medium text-ink">
          Poznámka <span class="text-muted/70">(nepovinné)</span>
        </label>
<textarea
  id="res-note"
  name="note"
  rows="3"
  maxlength="500"
  data-auto-grow
          placeholder="Alergie, oslava, dětská židle…"
          class="mt-2 block w-full resize-none overflow-hidden rounded-md border border-ink/15 px-3 py-2 text-ink placeholder:text-muted/70 focus:border-ochre focus:outline-none focus:ring-1 focus:ring-ochre"
        ></textarea>
      </div>

      <div class="flex items-start gap-3">
        <input
          type="checkbox"
          id="res-consent"
          name="consent"
          required
          class="mt-1 h-4 w-4 rounded border-ink/15 text-ochre focus:ring-ochre"
        />
        <div>
          <label for="res-consent" class="text-sm text-muted">
            Souhlasím se zpracováním osobních údajů za účelem vyřízení rezervace.
            <span class="text-muted/70">*</span>
          </label>
          <p data-error-for="res-consent" class="mt-1 hidden text-sm text-red-600" aria-live="polite"></p>
        </div>
      </div>

      <div class="flex flex-col gap-3 border-t border-ink/5 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted">
          Nebo zavolejte: <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="text-ink hover:underline">{site.contact.phone}</a>
        </p>
        <button
          type="submit"
          class="rounded-full bg-ochre px-6 py-3 text-sm font-medium text-parchment hover:bg-ochre/90 disabled:cursor-not-allowed disabled:opacity-60"
          data-submit
        >
          Odeslat rezervaci
        </button>
      </div>

      <p
        data-form-status
        role="status"
        aria-live="polite"
        class="hidden rounded-md p-3 text-sm"
      ></p>
    </form>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-reservation-form]');
    if (!form) return;

    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const fields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
      'input, select, textarea'
    );

    // Auto-grow textarea. Collapse to 'auto' first so scrollHeight reflects
    // content, not current height — that's what allows shrinking as well as
    // growing.
    const autoGrow = (el: HTMLTextAreaElement) => {
      el.style.height = 'auto';
      el.style.height = `${el.scrollHeight}px`;
    };

    form.querySelectorAll<HTMLTextAreaElement>('textarea[data-auto-grow]').forEach((el) => {
      autoGrow(el);
      el.addEventListener('input', () => autoGrow(el));
    });

    function errorEl(field: HTMLInputElement | HTMLSelectElement) {
      return form!.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
    }

    function clearError(field: HTMLInputElement | HTMLSelectElement) {
      const el = errorEl(field);
      if (el) {
        el.textContent = '';
        el.classList.add('hidden');
      }
      field.removeAttribute('aria-invalid');
    }

    function showError(field: HTMLInputElement | HTMLSelectElement, message: string) {
      const el = errorEl(field);
      if (el) {
        el.textContent = message;
        el.classList.remove('hidden');
      }
      field.setAttribute('aria-invalid', 'true');
    }

    const messages: Record<string, string> = {
      'res-date': 'Vyberte prosím datum.',
      'res-time': 'Vyberte prosím čas.',
      'res-party': 'Vyberte počet osob.',
      'res-name': 'Zadejte prosím jméno.',
      'res-email': 'Zadejte prosím platný e-mail.',
      'res-consent': 'Bez souhlasu nemůžeme rezervaci přijmout.',
    };

    function validateField(field: HTMLInputElement | HTMLSelectElement): boolean {
      if (!field.checkValidity()) {
        showError(field, messages[field.id] ?? 'Zkontrolujte prosím toto pole.');
        return false;
      }
      clearError(field);
      return true;
    }

    fields.forEach((field) => {
      field.addEventListener('blur', () => {
        if (field.value || field.required) validateField(field);
      });
      field.addEventListener('input', () => clearError(field));
      field.addEventListener('change', () => clearError(field));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const invalid = [...fields].filter((f) => !validateField(f));
      if (invalid.length > 0) {
        invalid[0].focus();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Odesílám…';
      status.className = 'hidden';

      try {
        const data = new FormData(form);
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });

        if (!res.ok) throw new Error(String(res.status));

        form.reset();
        status.textContent = 'Děkujeme! Rezervaci jsme přijali a ozveme se e-mailem.';
        status.className = 'rounded-md bg-green-50 p-3 text-sm text-green-800';
      } catch {
        status.textContent = 'Odeslání se nezdařilo. Zkuste to prosím znovu, nebo nám zavolejte.';
        status.className = 'rounded-md bg-red-50 p-3 text-sm text-red-800';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Odeslat rezervaci';
      }
    });
  });
</script>