---
const { title, intro } = Astro.props;
---

<section class="border-b border-ink/10 bg-cream">
  <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:py-20">
    <h1 class="font-display text-4xl font-bold text-ink sm:text-5xl">{title}</h1>
    {intro && <p class="mt-4 text-lg text-muted print:hidden">{intro}</p>}
  </div>
</section>