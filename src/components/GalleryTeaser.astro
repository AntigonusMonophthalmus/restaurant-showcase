---
import { Image } from 'astro:assets';
import { galleryAlt } from '../data/gallery.js';

const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const images = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .slice(0, 4)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!;
    return {
      filename,
      src: mod.default,
      alt: galleryAlt[filename] ?? '',
    };
  });
---

<section class="bg-parchment py-16">
  <div class="mx-auto max-w-6xl px-4">
    <header class="mb-10 text-center">
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">U nás</h2>
      <p class="mt-2 text-muted">Podívejte se, jak to u nás vypadá.</p>
    </header>

    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4">
      {images.map((img) => (
        <a
          href="/gallery"
          class="group relative overflow-hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-ochre focus-visible:ring-offset-2"
        >
          <Image
            src={img.src}
            alt={img.alt}
            widths={[400, 800]}
            sizes="(min-width: 768px) 25vw, 50vw"
            loading="lazy"
            class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/gallery"
        class="inline-block rounded-full border border-ink/15 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ochre hover:text-ochre"
      >
        Celá galerie
      </a>
    </div>
  </div>
</section>