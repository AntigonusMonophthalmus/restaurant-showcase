---
import { menu } from '../data/menu.js';

const featured = Object.values(menu)
  .flatMap((cat) => cat.items)
  .filter((item) => item.featured);
---

<section class="bg-cream py-16">
  <div class="mx-auto max-w-4xl px-4">
    <header class="mb-10 text-center">
      <h2 class="font-display text-3xl font-bold text-ink sm:text-4xl">Naše speciality</h2>
      <p class="mt-2 text-muted">Pár jídel, na která jsme pyšní.</p>
    </header>

    <ul class="divide-y divide-ink/5">
      {featured.map((item) => (
        <li class="flex items-baseline justify-between gap-6 py-5">
          <div>
            <h3 class="font-medium text-ink">{item.name}</h3>
            {item.description && (
              <p class="mt-1 text-sm text-muted">{item.description}</p>
            )}
          </div>
          <span class="whitespace-nowrap font-medium text-ink">{item.price} Kč</span>
        </li>
      ))}
    </ul>

    <div class="mt-10 text-center">
      <a
        href="/menu"
        class="inline-block rounded-full border border-ink/15 px-6 py-3 text-sm font-medium text-ink transition-colors hover:border-ochre hover:text-ochre"
      >
        Zobrazit celé menu
      </a>
    </div>
  </div>
</section>