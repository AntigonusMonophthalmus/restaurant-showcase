---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MenuTabs from '../components/MenuTabs.astro';
---

<BaseLayout
  title="Menu — Restaurace Pod Trúbou"
  description="Tradiční moravskoslezská kuchyně — předkrmy, hlavní chody, dezerty a nápoje."
>
  <PageHeader
    title="Menu"
    intro="Vaříme z místních surovin, v sezóně i z vlastní zahrady."
  />

 <div class="mx-auto flex max-w-4xl justify-end px-4 pt-6 print:hidden">
    <a
      href="/menu.pdf"
      download
      class="inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ochre"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      Stáhnout PDF
    </a>
  </div>

  <MenuTabs />
</BaseLayout>